+package com.reactnativecommunity.webview;
+
+import android.util.Log;
+import android.webkit.WebView;
+
+import androidx.webkit.WebViewCompat;
+import androidx.webkit.WebViewFeature;
+
+import java.util.Set;
+
+/**
+ * NewDeaf: install an XHR/fetch capture hook at document-start for every frame
+ * (including cross-origin player iframes) without re-fetching HTML.
+ *
+ * Re-fetching the player document via HttpURLConnection breaks Borth (TLS/session
+ * bound). {@link WebViewCompat#addDocumentStartJavaScript} injects into the live
+ * WebView network stack instead.
+ *
+ * Also handles {@code nd_fetch} postMessage requests so downloads can use Chrome's
+ * network stack (vkvideo.cloud returns 403 to OkHttp/curl on some device networks).
+ */
+public final class NdStreamHookInterceptor {
+  private static final String TAG = "NdStreamHook";
+
+  /** Compact hook — installed at document start inside player iframes. */
+  public static final String STREAM_HOOK_JS =
+    "(function(){"
+      + "if(window.__ndHookInstalled)return;"
+      + "window.__ndHookInstalled=true;"
+      + "function post(p){try{window.ReactNativeWebView&&window.ReactNativeWebView.postMessage(JSON.stringify(p))}catch(e){}}"
+      + "function emit(data,url){"
+      + "try{"
+      + "if(!data||!Array.isArray(data.hlsSource)||!data.hlsSource.length)return;"
+      + "var slim={hlsSource:data.hlsSource.map(function(s){return{label:s.label,audioId:s.audioId,quality:s.quality||{}}}),"
+      + "tracks:(data.tracks||[]).map(function(t){return{kind:t.kind,label:t.label,src:t.src}}),"
+      + "skipTime:data.skipTime||null,removeTime:data.removeTime||null};"
+      + "post({type:'debug',message:'bnsi_ok',url:String(url||''),keys:[String(slim.hlsSource.length)]});"
+      + "post({type:'stream',data:slim});"
+      + "}catch(err){post({type:'error',message:String(err&&err.message||err)})}"
+      + "}"
+      + "var ofetch=window.fetch;"
+      + "try{"
+      + "var XO=XMLHttpRequest.prototype.open,XS=XMLHttpRequest.prototype.send;"
+      + "XMLHttpRequest.prototype.open=function(m,u){this.__ndUrl=u;return XO.apply(this,arguments)};"
+      + "XMLHttpRequest.prototype.send=function(){"
+      + "this.addEventListener('load',function(){"
+      + "try{"
+      + "var t='';"
+      + "if(this.responseType==='json'&&this.response&&typeof this.response==='object'){emit(this.response,this.__ndUrl);return;}"
+      + "t=this.responseText||'';"
+      + "if(t.indexOf('hlsSource')!==-1){emit(JSON.parse(t),this.__ndUrl)}"
+      + "}catch(e){}"
+      + "});"
+      + "return XS.apply(this,arguments)"
+      + "};"
+      + "}catch(e){}"
+      + "try{"
+      + "if(typeof ofetch==='function'){"
+      + "window.fetch=function(){var args=arguments,url=String(args[0]&&args[0].url?args[0].url:args[0]);"
+      + "return ofetch.apply(this,args).then(function(res){"
+      + "try{if(String(url).indexOf('/bnsi/')!==-1){res.clone().text().then(function(text){"
+      + "if(text.indexOf('hlsSource')!==-1){try{emit(JSON.parse(text),url)}catch(e){}}"
+      + "}).catch(function(){})}}"
+      + "catch(e){}return res})} }"
+      + "}catch(e){}"
+      + "function b64(buf){"
+      + "var bytes=new Uint8Array(buf),chunk=0x8000,binary='';"
+      + "for(var i=0;i<bytes.length;i+=chunk){binary+=String.fromCharCode.apply(null,bytes.subarray(i,i+chunk));}"
+      + "return btoa(binary);"
+      + "}"
+      + "window.__ndBinCache=window.__ndBinCache||{};"
+      + "function postBin(id,status,buf,contentLength){"
+      + "var byteLength=buf&&buf.byteLength||0;"
+      + "var s=b64(buf||new ArrayBuffer(0)),cs=45000,count=Math.max(1,Math.ceil(s.length/cs));"
+      + "for(var i=0;i<count;i++){"
+      + "post({type:'nd_fetch_result',id:id,status:status,encoding:'base64',index:i,count:count,body:s.slice(i*cs,(i+1)*cs),contentLength:contentLength,byteLength:byteLength});"
+      + "}"
+      + "}"
+      + "window.addEventListener('message',function(ev){"
+      + "try{"
+      + "var d=ev&&ev.data;"
+      + "if(typeof d==='string'){try{d=JSON.parse(d)}catch(e){return}}"
+      + "if(!d||d.type!=='nd_fetch')return;"
+      + "window.__ndFetch&&window.__ndFetch(d.id,d.url,d.mode||'text',d.range||null);"
+      + "}catch(e){}"
+      + "});"
+      + "window.__ndFetch=function(id,url,mode,range){"
+      + "try{"
+      + "mode=mode||'text';"
+      + "if(mode==='bin'&&range&&window.__ndBinCache[url]){"
+      + "try{"
+      + "var cached=window.__ndBinCache[url];"
+      + "var sliced=cached.slice(range.offset,range.offset+range.length);"
+      + "if(sliced.byteLength!==range.length){post({type:'nd_fetch_result',id:id,error:'byte length mismatch: '+sliced.byteLength+'!='+range.length});return;}"
+      + "postBin(id,200,sliced,range.length);return;"
+      + "}catch(e){post({type:'nd_fetch_result',id:id,error:String(e&&e.message||e)});return;}"
+      + "}"
+      + "var xhr=new XMLHttpRequest();"
+      + "xhr.open('GET',url,true);"
+      + "xhr.withCredentials=false;"
+      + "xhr.responseType=mode==='bin'?'arraybuffer':'text';"
+      + "if(mode==='bin'&&range&&typeof range.offset==='number'&&typeof range.length==='number'){"
+      + "xhr.setRequestHeader('Range','bytes='+range.offset+'-'+(range.offset+range.length-1));"
+      + "}"
+      + "xhr.onload=function(){"
+      + "try{"
+      + "if(mode==='bin'){"
+      + "var buf=xhr.response||new ArrayBuffer(0);"
+      + "var clHeader=xhr.getResponseHeader('Content-Length');"
+      + "var contentLength=clHeader!=null&&clHeader!==''?Number(clHeader):null;"
+      + "if(range&&typeof range.offset==='number'&&typeof range.length==='number'){"
+      + "if(xhr.status===200){"
+      + "window.__ndBinCache[url]=buf;"
+      + "buf=buf.slice(range.offset,range.offset+range.length);"
+      + "contentLength=range.length;"
+      + "}else if(xhr.status===206){"
+      + "contentLength=range.length;"
+      + "}"
+      + "if(buf.byteLength!==range.length){"
+      + "post({type:'nd_fetch_result',id:id,error:'byte length mismatch: '+buf.byteLength+'!='+range.length});"
+      + "return;"
+      + "}"
+      + "}"
+      + "postBin(id,xhr.status,buf,contentLength);"
+      + "}else{"
+      + "post({type:'nd_fetch_result',id:id,status:xhr.status,body:String(xhr.responseText||''),index:0,count:1});"
+      + "}"
+      + "}catch(e){post({type:'nd_fetch_result',id:id,error:String(e&&e.message||e)});}"
+      + "};"
+      + "xhr.onerror=function(){post({type:'nd_fetch_result',id:id,error:'xhr network error'});};"
+      + "xhr.ontimeout=function(){post({type:'nd_fetch_result',id:id,error:'xhr timeout'});};"
+      + "xhr.timeout=120000;"
+      + "xhr.send();"
+      + "}catch(e){post({type:'nd_fetch_result',id:id,error:String(e&&e.message||e)});}"
+      + "};"
+      + "function collectVideos(root,out){"
+      + "try{"
+      + "var list=root.querySelectorAll?root.querySelectorAll('video'):[];"
+      + "for(var i=0;i<list.length;i++)out.push(list[i]);"
+      + "var all=root.querySelectorAll?root.querySelectorAll('*'):[];"
+      + "for(var j=0;j<all.length;j++){"
+      + "if(all[j].shadowRoot)collectVideos(all[j].shadowRoot,out);"
+      + "}"
+      + "}catch(e){}"
+      + "}"
+      + "function findVideo(root){"
+      + "var vids=[];collectVideos(root,vids);"
+      + "if(!vids.length)return null;"
+      + "var best=null,bestScore=-1;"
+      + "for(var i=0;i<vids.length;i++){"
+      + "var v=vids[i],score=0;"
+      + "try{"
+      + "if(!v.paused&&!v.ended)score+=1000;"
+      + "score+=Math.min(500,Math.floor((Number(v.currentTime)||0)));"
+      + "var w=v.videoWidth||v.clientWidth||0,h=v.videoHeight||v.clientHeight||0;"
+      + "score+=Math.min(200,Math.floor((w*h)/10000));"
+      + "}catch(e){}"
+      + "if(score>bestScore){bestScore=score;best=v;}"
+      + "}"
+      + "return best||vids[0];"
+      + "}"
+      + "var __ndBoundVideo=null,__ndLastProgressAt=0;"
+      + "function emitProgress(force){"
+      + "try{"
+      + "var video=findVideo(document);"
+      + "if(!video)return;"
+      + "var ct=Number(video.currentTime)||0;"
+      + "var dur=Number(video.duration);"
+      + "if(!(ct>0))return;"
+      + "var now=Date.now();"
+      + "if(!force&&now-__ndLastProgressAt<800)return;"
+      + "__ndLastProgressAt=now;"
+      + "post({type:'progress',currentTime:ct,duration:isFinite(dur)&&dur>0?dur:null});"
+      + "}catch(e){}"
+      + "}"
+      + "function bindVideo(video){"
+      + "if(!video||video===__ndBoundVideo)return;"
+      + "__ndBoundVideo=video;"
+      + "try{"
+      + "video.addEventListener('seeked',function(){emitProgress(true)});"
+      + "video.addEventListener('pause',function(){emitProgress(true)});"
+      + "video.addEventListener('timeupdate',function(){emitProgress(false)});"
+      + "}catch(e){}"
+      + "}"
+      + "setInterval(function(){"
+      + "try{bindVideo(findVideo(document));emitProgress(false)}catch(e){}"
+      + "},1000);"
+      + "post({type:'debug',message:'hook_ready',url:String(window!==window.top)});"
+      + "})();";
+
+  public static void installDocumentStartHook(WebView webView) {
+    if (webView == null) return;
+    try {
+      if (!WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {
+        Log.w(TAG, "DOCUMENT_START_SCRIPT not supported on this WebView");
+        return;
+      }
+      WebViewCompat.addDocumentStartJavaScript(webView, STREAM_HOOK_JS, Set.of("*"));
+      Log.i(TAG, "Installed document-start stream hook");
+    } catch (Exception e) {
+      Log.w(TAG, "Failed to install document-start hook", e);
+    }
+  }
+}
